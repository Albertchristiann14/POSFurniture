# ==========================================
# KREVIA POS - ENVIRONMENT CONFIGURATION
# ==========================================

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://krevia_user:krevia_password@localhost:5432/krevia_pos?schema=public"

# Redis (Cache, Lock, Rate Limiter)
REDIS_URL="redis://localhost:6379"

# Security & Data Privacy (UU PDP)
# Key must be 64 hex characters (32 bytes) for AES-256-GCM
DATA_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Salt for HMAC-SHA256 Blind Index
BLIND_INDEX_SALT="krevia_furniture_blind_index_salt_super_secret_value_2026"

# Authentication & Sessions
JWT_SECRET="krevia_jwt_secret_staff_pos_furniture_change_in_production"
SESSION_EXPIRY_HOURS=12

# Storage (S3 / MinIO for encrypted customer credit documents)
STORAGE_DRIVER=local # 'local' or 's3'
STORAGE_LOCAL_PATH="./storage/documents"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="krevia-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# Payment Gateway (Adapter configuration)
PAYMENT_GATEWAY_PROVIDER="MOCK" # 'MOCK', 'MIDTRANS', 'XENDIT'
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
